services:
  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    restart: unless-stopped
    environment:
      PUID: "1000"
      PGID: "1000"
      TZ: "{{ timezone }}"
    ports:
      - "8989:8989"
    volumes:
      - {{ sonarr_dir }}/config:/config
      - /opt/homelab/downloads:/opt/homelab/downloads
      - /opt/homelab/jellyfin/media/Inbox:/opt/homelab/jellyfin/media/Inbox
