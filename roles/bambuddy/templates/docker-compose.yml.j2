services:
  bambuddy:
    image: {{ bambuddy_image }}
    container_name: {{ bambuddy_container_name }}
    restart: unless-stopped
    cap_add:
      - NET_BIND_SERVICE
    network_mode: host
    volumes:
      - {{ bambuddy_dir }}/data:/app/data
      - {{ bambuddy_dir }}/logs:/app/logs
    env_file:
      - .env
