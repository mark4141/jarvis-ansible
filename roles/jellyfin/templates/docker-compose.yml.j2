services:
  jellyfin:
    image: lscr.io/linuxserver/jellyfin:latest
    container_name: jellyfin
    restart: unless-stopped
    network_mode: host
    environment:
      TZ: "{{ timezone }}"
      PUID: "1000"
      PGID: "1000"
    volumes:
      - {{ jellyfin_dir }}/config:/config
      - {{ jellyfin_dir }}/cache:/cache
      - {{ jellyfin_dir }}/media:/media
