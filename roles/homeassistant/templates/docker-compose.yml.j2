services:
  homeassistant:
    image: ghcr.io/home-assistant/home-assistant:2026.9
    container_name: homeassistant
    restart: unless-stopped
    network_mode: host
    privileged: true
    environment:
      TZ: "{{ timezone }}"
    volumes:
      - {{ homeassistant_dir }}/config:/config
      - /etc/localtime:/etc/localtime:ro
      - /run/dbus:/run/dbus:ro
